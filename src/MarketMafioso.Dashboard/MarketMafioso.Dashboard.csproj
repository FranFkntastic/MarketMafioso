<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <UsesFranthropy>true</UsesFranthropy>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketMafioso.Contracts\MarketMafioso.Contracts.csproj" />
    <PackageReference Include="Franthropy.FFXIV" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.FFXIV/Franthropy.FFXIV.csproj" Condition="'$(FranthropySource)' == 'Local'" />
    <PackageReference Include="Franthropy.Web" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.Web/Franthropy.Web.csproj" Condition="'$(FranthropySource)' == 'Local'" />
  </ItemGroup>

</Project>
