<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <UsesFranthropy>true</UsesFranthropy>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Franthropy.Filtering" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.Filtering/Franthropy.Filtering.csproj" Condition="'$(FranthropySource)' == 'Local'" />
  </ItemGroup>
</Project>
